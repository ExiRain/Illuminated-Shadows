}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_attack"
2d_physics/layer_7="enemy_attack"
2d_physics/layer_8="soul"
2d_physics/layer_9="interactable"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.1, 1)
